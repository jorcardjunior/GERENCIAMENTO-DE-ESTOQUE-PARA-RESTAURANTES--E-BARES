#lovable-badge {
  display: none !important;
}

@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-cyan: var(--cyan);
  --color-cyan-glow: var(--cyan-glow);
  --color-gold: var(--gold);
  --color-gold-light: var(--gold-light);
  --color-gold-glow: var(--gold-glow);
  --color-success: var(--success);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --font-display: "Plus Jakarta Sans", "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
}

/* Smart Eco Stock — Modern Restaurant Inventory */
:root, .dark {
  --radius: 1rem;

  --background: #020617;
  --foreground: #f8fafc;
  --card: rgba(15, 23, 42, 0.4);
  --card-foreground: #f8fafc;
  --popover: #020617;
  --popover-foreground: #f8fafc;

  --primary: #10b981;
  --primary-foreground: #020617;
  --secondary: #1e293b;
  --secondary-foreground: #f8fafc;
  --muted: #1e293b;
  --muted-foreground: #94a3b8;
  --accent: #10b981;
  --accent-foreground: #f8fafc;
  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --border: rgba(255, 255, 255, 0.06);
  --input: rgba(15, 23, 42, 0.6);
  --ring: #10b981;

  --emerald: #10b981;
  --emerald-glow: rgba(16, 185, 129, 0.3);
  --amber: #f59e0b;
  --amber-glow: rgba(245, 158, 11, 0.3);
  --rose: #f43f5e;
  --rose-glow: rgba(244, 63, 94, 0.3);

  --chart-1: #10b981;
  --chart-2: #3b82f6;
  --chart-3: #8b5cf6;
  --chart-4: #f59e0b;
  --chart-5: #f43f5e;

  --gradient-emerald: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --gradient-noir: radial-gradient(circle at 50% 0%, #0f172a 0%, #020617 100%);
  --shadow-emerald: 0 0 25px rgba(16, 185, 129, 0.2);
  --shadow-card: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
}

@layer base {
  * { border-color: var(--color-border); }
  html, body { 
    background: var(--gradient-noir); 
    color: var(--color-foreground); 
    min-height: 100vh;
    background-attachment: fixed;
  }
  body {
    font-family: var(--font-sans);
    font-feature-settings: "cv02","cv03","cv04";
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .font-display { font-family: var(--font-display); letter-spacing: -0.02em; }
}

@layer utilities {
  .overflow-x-hidden { overflow-x: hidden; }
  .touch-target { min-height: 44px; min-width: 44px; }
  .text-gradient-emerald {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bg-gradient-emerald { background: var(--gradient-emerald); }
  .shadow-emerald { box-shadow: 0 10px 30px -5px rgba(16, 185, 129, 0.2); }
  .glass-card {
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .glass-dock {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .vibrant-glow {
    position: relative;
  }
  .vibrant-glow::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.5), transparent);
    border-radius: inherit;
    z-index: -1;
    opacity: 0.5;
    filter: blur(8px);
  }
  .shadow-card { box-shadow: var(--shadow-card); }
  
  /* Premium Segmented Control Animation */
  .segmented-control-active {
    position: absolute;
    inset: 4px;
    background: var(--primary);
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    z-index: 0;
  }
}

/* Hide Lovable badge */
#lovable-badge,
#lovable-badge-v2,
[id^="lovable-badge"],
a[href*="lovable.dev"][target="_blank"] {
  display: none !important;
}
