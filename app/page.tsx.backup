// ==========================================
// NAVEGAÇÃO NO RODAPÉ
// ==========================================
function FooterNav() {
  const links = [
    { label: "FUNCIONALIDADES", href: "#recursos" },
    { label: "PREÇOS", href: "#planos" },
    { label: "ENTRAR", href: "/auth/login" },
    { label: "SUPORTE", href: "mailto:suporte@estoquest.com" },
    { label: "TERMOS DE USO", href: "#" },
  ];

  return (
    <div className="bg-slate-950 border-t border-slate-800/60 py-6">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {links.map((link) => (
            <Link
              key={link.label}
              href={link.href}
              className="text-xs uppercase tracking-wider text-slate-400 hover:text-blue-400 transition-colors"
            >
              {link.label}
            </Link>
          ))}
        </div>
      </div>
    </div>
  );
}

