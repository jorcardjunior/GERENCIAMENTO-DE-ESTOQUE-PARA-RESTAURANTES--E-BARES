          <div className="flex gap-6">
            <Link href="/auth/login" className="text-slate-400 hover:text-white transition-colors text-sm">Login</Link>
            <Link href="/auth/register" className="text-slate-400 hover:text-white transition-colors text-sm">Cadastrar</Link>
          </div>
        </div>
      </div>
