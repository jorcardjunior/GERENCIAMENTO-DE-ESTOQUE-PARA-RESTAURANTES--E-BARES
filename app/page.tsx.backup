function FAQSection() {
  const faqs = [
    {
      question: "Como funciona o teste grátis de 15 dias?",
      answer: "Você pode usar todas as funcionalidades do plano Profissional por 15 dias sem pagar nada. Não é necessário cartão de crédito. Após o período, escolha o plano que mais se adequa ao seu negócio."
    },
    {
      question: "Posso mudar de plano depois?",
      answer: "Sim! Você pode fazer upgrade ou downgrade do seu plano a qualquer momento. A mudança será aplicada no próximo ciclo de cobrança."
    },
    {
      question: "O sistema funciona no celular?",
      answer: "Sim! O EstoqueRest é uma aplicação web responsiva, funcionando perfeitamente em computadores, tablets e smartphones, sem necessidade de instalar nenhum aplicativo."
    },
    {
      question: "Como funciona o controle de estoque?",
      answer: "Você pode cadastrar categorias e itens, definir quantidades mínimas, acompanhar validades e receber alertas automáticos quando produtos estiverem acabando ou próximos ao vencimento."
    },
    {
      question: "Posso gerenciar mais de um estabelecimento?",
      answer: "Sim. O plano Mensal inclui 1 estabelecimento, o Semestral até 3, e o Anual permite gerenciar até 10 estabelecimentos simultaneamente com controle centralizado.",
    },
    {
      question: "Meus dados estão seguros?",
      answer: "Absolutamente. Utilizamos criptografia em todos os dados, fazer backups diários automáticos e seguimos as melhores práticas de segurança da indústria."
    },
    {
      question: "Como funciona o suporte?",
      answer: "Oferecemos suporte por e-mail para todos os planos. Planos Semestrais e Anuais contam com suporte prioritário via chat em horário comercial. Plano Anual tem suporte dedicado."
    },
    {
      question: "Posso cancelar a qualquer momento?",
      answer: "Sim, não há fidelidade. Você pode cancelar sua assinatura a qualquer momento e continuar usando até o final do período já pago."
    }
  ];

  return (
    <Section id="faq" className="py-24 bg-slate-900">
      <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeInView className="text-center mb-20">
