"use client";

import { useState, useEffect, useCallback, useMemo } from "react";
import { useAuth } from "@/hooks/use-auth";
import {
  BrainCircuit, Loader2, TrendingUp, CalendarDays,
  PiggyBank, LineChart, Flame, BarChart3,
} from "lucide-react";
import { DonutChart, Sparkline, GaugeChart, gerarTrend, calcVariacao } from "@/components/charts";
import {
  BarChart as RechartsBarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  ResponsiveContainer,
  Cell,
  Tooltip,
  AreaChart,
  Area,
  ScatterChart,
  Scatter,
  Legend,
} from "recharts";

type Category = { id: number; name: string; color: string; items: any[] };

function formatCurrency(val: number) {
  return val.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

const DARK_BG = "#0f1929";

function NeuCard({ children, className = "" }: { children: React.ReactNode; className?: string }) {
  return (
    <div
      className={`rounded-2xl ${className}`}
      style={{
        background: "linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02))",
        boxShadow: "6px 6px 14px rgba(0,0,0,0.4), -4px -4px 12px rgba(255,255,255,0.03), inset 0 1px 0 rgba(255,255,255,0.06)",
        border: "1px solid rgba(255,255,255,0.06)",
      }}
    >
      {children}
    </div>
  );
}

const CATEGORIAS_MOCK = ["Bebidas", "Carnes", "Hortifrúti", "Laticínios", "Secos", "Limpeza"];
const CORES_CAT = ["#2563eb", "#f43f5e", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899"];

function gerarGiroPorCategoria() {
  return CATEGORIAS_MOCK.map((nome, i) => ({
    name: nome,
    giro: Number((2 + Math.random() * 10).toFixed(1)),
    dias: Number((3 + Math.random() * 25).toFixed(0)),
    fill: CORES_CAT[i % CORES_CAT.length],
  }));
}

function gerarPerdaPorTipo() {
  return [
    { label: "Vencimento", value: 500 + Math.round(Math.random() * 2000), color: "#ef4444" },
    { label: "Preparo", value: 300 + Math.round(Math.random() * 1000), color: "#f59e0b" },
    { label: "Sobra", value: 200 + Math.round(Math.random() * 800), color: "#8b5cf6" },
    { label: "Quebra", value: 100 + Math.round(Math.random() * 500), color: "#ec4899" },
  ];
}

function gerarScatterData() {
  const pratos = [
    "Filé à Parmegiana", "Moqueca", "Salada Caesar", "Pizza Margherita",
    "Hambúrguer Artesanal", "Sushi Combo", "Risoto de Camarão", "Feijoada",
    "Lasanha", "Taco Mexicano", "Ceviche", "Espaguete Carbonara",
    "Frango Grelhado", "Bowl Vegano", "Costela no Bafo",
  ];
  return pratos.map(nome => {
    const custo = 5 + Math.random() * 30;
    const margem = 1.3 + Math.random() * 1.2;
    return {
      nome,
      custo: Number(custo.toFixed(2)),
      preco: Number((custo * margem).toFixed(2)),
      lucro: Number((custo * (margem - 1)).toFixed(2)),
    };
  });
}

function gerarSazonalidade() {
  const dias = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];
  const cores = ["#6366f1", "#6366f1", "#6366f1", "#6366f1", "#f43f5e", "#f97316", "#f97316"];
  return dias.map((d, i) => ({
    dia: d,
    consumo: 60 + Math.round(Math.random() * 150) + (i >= 4 ? 40 : 0),
    fill: cores[i],
  }));
}

function gerarBudgetReal() {
  const meses = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun"];
  return meses.map((mes, i) => {
    const base = 8000 + i * 300 + Math.random() * 2000;
    return { mes, previsto: Math.round(base), real: Math.round(base * (0.85 + Math.random() * 0.3)) };
  });
}

function gerarPrevisao() {
  const atual = 10000;
  const declinio = 50 + Math.random() * 100;
  return Array.from({ length: 14 }, (_, i) => ({
    dia: `D${i + 1}`,
    atual: Math.round(Math.max(atual - i * declinio * 0.5, 2000)),
    projetado: Math.round(Math.max(atual - i * declinio, 1000)),
  }));
}

function calcHealthScore(giroMedio: number, perdaTotalVal: number, margemMedia: number): number {
  let score = 50;
  score += Math.min(giroMedio * 3, 20);
  score += Math.min(Math.max(100 - (perdaTotalVal / 100), 0) * 0.15, 15);
  score += Math.min(margemMedia * 5, 15);
  return Math.round(Math.min(Math.max(score, 0), 100));
}

export default function BiPage() {
  const { user } = useAuth();
  const [categories, setCategories] = useState<Category[]>([]);
  const [loading, setLoading] = useState(true);

  const loadData = useCallback(async () => {
    setLoading(true);
    const [catRes] = await Promise.all([fetch("/api/categories")]);
    if (catRes.ok) setCategories(await catRes.json());
    setLoading(false);
  }, []);

  useEffect(() => { loadData(); }, [loadData]);

  const allItems = useMemo(() => categories.flatMap((c) => c.items), [categories]);

  const giroData = useMemo(() => gerarGiroPorCategoria(), []);
  const perdaData = useMemo(() => gerarPerdaPorTipo(), []);
  const scatterData = useMemo(() => gerarScatterData(), []);
  const sazonalData = useMemo(() => gerarSazonalidade(), []);
  const budgetData = useMemo(() => gerarBudgetReal(), []);
  const previsaoData = useMemo(() => gerarPrevisao(), []);

  const giroMedio = useMemo(() => {
    if (giroData.length === 0) return 0;
    return giroData.reduce((s, d) => s + d.giro, 0) / giroData.length;
  }, [giroData]);

  const perdaTotal = useMemo(() => perdaData.reduce((s, p) => s + p.value, 0), [perdaData]);

  const margemMedia = useMemo(() => {
    if (scatterData.length === 0) return 0;
    const margens = scatterData.map(d => ((d.preco - d.custo) / d.custo) * 100);
    return margens.reduce((s, m) => s + m, 0) / margens.length;
  }, [scatterData]);

  const healthScore = useMemo(
    () => calcHealthScore(giroMedio, perdaTotal, margemMedia),
    [giroMedio, perdaTotal, margemMedia],
  );

  const perdaPctLabel = useMemo(() => {
    if (perdaTotal === 0) return "0%";
    const topType = perdaData.reduce((max, p) => p.value > max.value ? p : max, perdaData[0]);
    return `${(topType.value / perdaTotal * 100).toFixed(0)}%`;
  }, [perdaData, perdaTotal]);

  const scoreTrend = useMemo(() => gerarTrend(healthScore, 14, 0.08).map(v => Math.min(v, 100)), [healthScore]);
  const turnoverTrend = useMemo(() => gerarTrend(giroMedio, 14, 0.2), [giroMedio]);
  const lossTrend = useMemo(() => gerarTrend(perdaTotal / 10, 14, 0.3), [perdaTotal]);
  const marginTrend = useMemo(() => gerarTrend(margemMedia, 14, 0.15), [margemMedia]);

  const variacoes = useMemo(() => ({
    score: calcVariacao(scoreTrend),
    turnover: calcVariacao(turnoverTrend),
    loss: calcVariacao(lossTrend),
    margin: calcVariacao(marginTrend),
  }), [scoreTrend, turnoverTrend, lossTrend, marginTrend]);

  const gastoTotalPrevisto = useMemo(() => budgetData.reduce((s, d) => s + d.previsto, 0), [budgetData]);
  const gastoTotalReal = useMemo(() => budgetData.reduce((s, d) => s + d.real, 0), [budgetData]);
  const budgetDiff = useMemo(() => {
    if (gastoTotalPrevisto === 0) return "0";
    return `${((gastoTotalReal - gastoTotalPrevisto) / gastoTotalPrevisto * 100).toFixed(0)}`;
  }, [gastoTotalReal, gastoTotalPrevisto]);

  if (loading) return (
    <div className="flex items-center justify-center py-20" style={{ backgroundColor: DARK_BG, minHeight: "100%" }}>
      <Loader2 className="h-8 w-8 animate-spin" style={{ color: "#2563eb" }} />
    </div>
  );

  const statCards = [
    {
      title: "Health Score", value: `${healthScore}/100`, icon: BrainCircuit, color: "#2563eb",
      sub: `Giro ${giroMedio.toFixed(1)}x`, trend: scoreTrend, variacao: variacoes.score,
    },
    {
      title: "Giro Médio", value: `${giroMedio.toFixed(1)}x`, icon: TrendingUp, color: "#10b981",
      sub: "Turnover de estoque", trend: turnoverTrend, variacao: variacoes.turnover,
    },
    {
      title: "Perda Total", value: formatCurrency(perdaTotal), icon: Flame, color: "#ef4444",
      sub: `${perdaData.length} tipos`, trend: lossTrend, variacao: variacoes.loss,
    },
    {
      title: "Margem Média", value: `${margemMedia.toFixed(0)}%`, icon: PiggyBank, color: "#f59e0b",
      sub: "Custo vs Preço", trend: marginTrend, variacao: variacoes.margin,
    },
  ];

  return (
    <div
      style={{ backgroundColor: DARK_BG, minHeight: "100%" }}
      className="rounded-3xl p-6 sm:p-8 space-y-6"
    >
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl sm:text-3xl font-bold text-white tracking-tight">Indicadores</h1>
          <p style={{ fontSize: "13px", color: "rgba(255,255,255,0.4)", marginTop: 4 }}>
            Visão executiva: turnover, perdas, margens e sazonalidade.
          </p>
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {statCards.map((card) => (
          <NeuCard key={card.title} className="p-6">
            <div className="flex items-center justify-between mb-4">
              <div
                style={{
                  width: 40, height: 40, borderRadius: "12px",
                  background: `${card.color}15`,
                  display: "flex", alignItems: "center", justifyContent: "center",
                }}
              >
                <card.icon className="w-5 h-5" style={{ color: card.color }} />
              </div>
              <div className="flex items-center gap-3">
                <div style={{ opacity: 0.5 }}>
                  <Sparkline data={card.trend} color={card.color} width={60} height={28} />
                </div>
                <span style={{
                  fontSize: "9px", fontWeight: 800,
                  color: card.variacao.positivo ? "#16a34a" : "#dc2626",
                  letterSpacing: "0.05em",
                }}>
                  {card.variacao.valor}
                </span>
              </div>
            </div>
            <p style={{ fontSize: "11px", fontWeight: 600, color: "rgba(255,255,255,0.4)", letterSpacing: "0.05em", marginBottom: 4 }}>{card.title}</p>
            <p className="text-2xl font-bold text-white tabular-nums mb-1">{card.value}</p>
            <p style={{ fontSize: "11px", color: "rgba(255,255,255,0.3)" }}>{card.sub}</p>
          </NeuCard>
        ))}
      </div>

      {/* Health Score Gauge */}
      <NeuCard className="p-8">
        <div className="flex flex-col items-center">
          <div className="flex items-center gap-2 mb-6">
            <BrainCircuit className="w-5 h-5" style={{ color: "#2563eb" }} />
            <h3 className="text-lg font-bold text-white">Health Score do Negócio</h3>
          </div>
          <p style={{ fontSize: "12px", color: "rgba(255,255,255,0.35)", marginBottom: 20 }}>
            Score composto: {giroMedio.toFixed(1)}x giro | {margemMedia.toFixed(0)}% margem | {perdaPctLabel} perda
          </p>
          <GaugeChart
            value={healthScore}
            max={100}
            size={200}
            color={healthScore > 70 ? "#10b981" : healthScore > 40 ? "#f59e0b" : "#ef4444"}
            label="SAÚDE DO NEGÓCIO"
            subtitle={`${healthScore}/100`}
          />
          <div className="grid grid-cols-3 gap-6 mt-8 w-full max-w-lg">
            {[
              { label: "Giro", value: `${giroMedio.toFixed(1)}x`, pct: Math.min(giroMedio / 10 * 100, 100), color: "#10b981" },
              { label: "Margem", value: `${margemMedia.toFixed(0)}%`, pct: Math.min(margemMedia, 100), color: "#2563eb" },
              { label: "Perda", value: perdaPctLabel, pct: Math.max(0, 100 - perdaTotal / 100), color: "#f59e0b" },
            ].map((m) => (
              <div key={`health-${m.label}`} className="flex flex-col items-center">
                <div className="w-full h-1.5 rounded-full" style={{ background: "rgba(255,255,255,0.06)", marginBottom: 8 }}>
                  <div className="h-full rounded-full" style={{ width: `${m.pct}%`, background: m.color, transition: "width 0.8s ease" }} />
                </div>
                <p style={{ fontSize: "11px", fontWeight: 700, color: "white" }}>{m.value}</p>
                <p style={{ fontSize: "9px", color: "rgba(255,255,255,0.35)" }}>{m.label}</p>
              </div>
            ))}
          </div>
        </div>
      </NeuCard>

      {/* Row: Giro × Dias × Perda */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <TrendingUp className="w-4 h-4" style={{ color: "#10b981" }} /> Giro de Estoque
            </h3>
          </div>
          <div style={{ width: "100%", height: 240 }}>
            <ResponsiveContainer width="100%" height="100%">
              <RechartsBarChart data={giroData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }} layout="vertical">
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" horizontal={false} />
                <XAxis type="number" tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 11 }} axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false} />
                <YAxis type="category" dataKey="name" tick={{ fill: "rgba(255,255,255,0.4)", fontSize: 11, fontWeight: 600 }} axisLine={false} tickLine={false} width={80} />
                <Tooltip contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", boxShadow: "0 8px 24px rgba(0,0,0,0.4)", color: "white", fontSize: "12px" }} cursor={{ fill: "rgba(255,255,255,0.03)" }} />
                <Bar dataKey="giro" radius={[0, 8, 8, 0]} maxBarSize={32}>
                  {giroData.map((entry, idx) => (
                    <Cell key={`giro-${entry.name}-${idx}`} fill={entry.fill} />
                  ))}
                </Bar>
              </RechartsBarChart>
            </ResponsiveContainer>
          </div>
        </NeuCard>

        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <CalendarDays className="w-4 h-4" style={{ color: "#f59e0b" }} /> Dias de Estoque (DIO)
            </h3>
          </div>
          <div style={{ width: "100%", height: 240 }}>
            <ResponsiveContainer width="100%" height="100%">
              <RechartsBarChart data={giroData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }} layout="vertical">
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" horizontal={false} />
                <XAxis type="number" tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 11 }} axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false} />
                <YAxis type="category" dataKey="name" tick={{ fill: "rgba(255,255,255,0.4)", fontSize: 11, fontWeight: 600 }} axisLine={false} tickLine={false} width={80} />
                <Tooltip contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", boxShadow: "0 8px 24px rgba(0,0,0,0.4)", color: "white", fontSize: "12px" }} cursor={{ fill: "rgba(255,255,255,0.03)" }} />
                <Bar dataKey="dias" radius={[0, 8, 8, 0]} maxBarSize={32}>
                  {giroData.map((entry, idx) => (
                    <Cell key={`dio-${entry.name}-${idx}`} fill="#f59e0b" />
                  ))}
                </Bar>
              </RechartsBarChart>
            </ResponsiveContainer>
          </div>
        </NeuCard>

        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center gap-2 mb-6">
            <Flame className="w-4 h-4" style={{ color: "#ef4444" }} />
            <h3 className="text-sm font-bold text-white">Perda por Tipo</h3>
          </div>
          {perdaData.length > 0 ? (
            <div className="flex flex-col items-center">
              <DonutChart slices={perdaData} size={180} innerRadius={60} total={perdaTotal} />
              <div className="w-full mt-4 space-y-2">
                {perdaData.map((p, pi) => (
                  <div key={`perda-${p.label}-${pi}`} className="flex items-center justify-between" style={{ fontSize: "11px" }}>
                    <div className="flex items-center gap-2">
                      <div className="w-2 h-2 rounded-full" style={{ backgroundColor: p.color, opacity: 0.7 }} />
                      <span style={{ color: "rgba(255,255,255,0.5)", fontWeight: 500 }}>{p.label}</span>
                    </div>
                    <span style={{ fontWeight: 700, color: "white" }}>{formatCurrency(p.value)}</span>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p style={{ color: "rgba(255,255,255,0.2)", fontSize: "13px", textAlign: "center", padding: 20 }}>Nenhum dado disponível</p>
          )}
        </NeuCard>
      </div>

      {/* Custo vs Preço - Scatter */}
      <NeuCard className="p-6 sm:p-8">
        <div className="flex items-center justify-between mb-6">
          <div>
            <h3 className="text-base font-bold text-white">Custo vs. Preço de Venda</h3>
            <p style={{ fontSize: "11px", color: "rgba(255,255,255,0.35)", marginTop: 2 }}>
              Cada ponto = um prato da ficha técnica — quanto mais acima da diagonal, maior a margem
            </p>
          </div>
          <div style={{
            padding: "4px 12px", borderRadius: "8px",
            background: "rgba(16,185,129,0.1)", fontSize: "10px", fontWeight: 700, color: "#34d399",
          }}>
            Lucro médio: {formatCurrency(scatterData.reduce((s, d) => s + d.lucro, 0) / scatterData.length)}
          </div>
        </div>
        <div style={{ width: "100%", minHeight: 300, height: 300 }}>
          <ResponsiveContainer width="100%" height="100%">
            <ScatterChart margin={{ top: 10, right: 20, left: -10, bottom: 0 }}>
              <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" />
              <XAxis
                dataKey="custo" type="number" name="Custo"
                tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 10 }}
                axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false}
                label={{ value: "Custo (R$)", position: "bottom", fill: "rgba(255,255,255,0.2)", fontSize: 10 }}
              />
              <YAxis
                dataKey="preco" type="number" name="Preço"
                tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 10 }}
                axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false}
                tickFormatter={(v: number) => `R$${v}`}
                label={{ value: "Preço (R$)", angle: -90, position: "left", fill: "rgba(255,255,255,0.2)", fontSize: 10 }}
              />
              <Tooltip
                contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", boxShadow: "0 8px 24px rgba(0,0,0,0.4)", color: "white", fontSize: "11px" }}
                formatter={(value: any, name: any) => [name === "Custo" || name === "Preço" ? `R$ ${Number(value).toFixed(2)}` : value]}
                labelFormatter={(label: any) => scatterData.find(d => d.nome === label)?.nome || String(label)}
              />
              <Legend
                wrapperStyle={{ fontSize: "11px", color: "rgba(255,255,255,0.5)" }}
                formatter={(val: any) => <span style={{ color: "rgba(255,255,255,0.6)" }}>{String(val)}</span>}
              />
              <Scatter
                data={scatterData.map(d => ({ ...d, label: d.nome }))}
                fill="#2563eb"
                fillOpacity={0.7}
                stroke="rgba(255,255,255,0.1)"
                strokeWidth={0.5}
                name="Pratos"
              />
            </ScatterChart>
          </ResponsiveContainer>
        </div>
      </NeuCard>

      {/* Row: Sazonalidade × Budget vs Real × Previsão */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <CalendarDays className="w-4 h-4" style={{ color: "#6366f1" }} /> Sazonalidade
            </h3>
            <span style={{ fontSize: "10px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em" }}>Consumo por dia</span>
          </div>
          <div style={{ width: "100%", height: 240 }}>
            <ResponsiveContainer width="100%" height="100%">
              <RechartsBarChart data={sazonalData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" vertical={false} />
                <XAxis dataKey="dia" tick={{ fill: "rgba(255,255,255,0.4)", fontSize: 11, fontWeight: 600 }} axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false} />
                <YAxis tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 11 }} axisLine={false} tickLine={false} />
                <Tooltip contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", boxShadow: "0 8px 24px rgba(0,0,0,0.4)", color: "white", fontSize: "12px" }} cursor={{ fill: "rgba(255,255,255,0.03)" }} />
                <Bar dataKey="consumo" radius={[8, 8, 0, 0]} maxBarSize={40}>
                  {sazonalData.map((entry, idx) => (
                    <Cell key={`saz-${entry.dia}-${idx}`} fill={entry.fill} />
                  ))}
                </Bar>
              </RechartsBarChart>
            </ResponsiveContainer>
          </div>
        </NeuCard>

        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <PiggyBank className="w-4 h-4" style={{ color: "#2563eb" }} /> Budget vs Real
            </h3>
            <span style={{ fontSize: "10px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em" }}>
              {budgetDiff}% diff
            </span>
          </div>
          <div style={{ width: "100%", height: 240 }}>
            <ResponsiveContainer width="100%" height="100%">
              <RechartsBarChart data={budgetData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" vertical={false} />
                <XAxis dataKey="mes" tick={{ fill: "rgba(255,255,255,0.4)", fontSize: 11, fontWeight: 600 }} axisLine={{ stroke: "rgba(255,255,255,0.06)" }} tickLine={false} />
                <YAxis tick={{ fill: "rgba(255,255,255,0.3)", fontSize: 10 }} axisLine={false} tickLine={false} tickFormatter={(v: number) => `${(v / 1000).toFixed(0)}k`} />
                <Tooltip
                  contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", boxShadow: "0 8px 24px rgba(0,0,0,0.4)", color: "white", fontSize: "11px" }}
                  formatter={(value: any) => formatCurrency(Number(value) || 0)}
                />
                <Bar dataKey="previsto" radius={[4, 4, 0, 0]} maxBarSize={20} fill="#2563eb" opacity={0.5} name="Previsto" />
                <Bar dataKey="real" radius={[4, 4, 0, 0]} maxBarSize={20} fill="#f59e0b" name="Real" />
              </RechartsBarChart>
            </ResponsiveContainer>
          </div>
        </NeuCard>

        <NeuCard className="p-6 sm:p-8">
          <div className="flex items-center justify-between mb-6">
            <h3 className="text-sm font-bold text-white flex items-center gap-2">
              <LineChart className="w-4 h-4" style={{ color: "#8b5cf6" }} /> Previsão de Estoque
            </h3>
          </div>
          <div style={{ width: "100%", minHeight: 200, height: 240 }}>
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart data={previsaoData} margin={{ top: 5, right: 5, left: -20, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.04)" vertical={false} />
                <XAxis dataKey="dia" tick={{ fill: "rgba(255,255,255,0.2)", fontSize: 9 }} axisLine={false} tickLine={false} />
                <YAxis tick={{ fill: "rgba(255,255,255,0.2)", fontSize: 9 }} axisLine={false} tickLine={false} tickFormatter={(v: number) => `${(v / 1000).toFixed(0)}k`} />
                <Tooltip
                  contentStyle={{ background: "#1a2738", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "12px", color: "white", fontSize: "11px", padding: "8px" }}
                  formatter={(value: any) => formatCurrency(Number(value) || 0)}
                />
                <Area type="monotone" dataKey="atual" stroke="#2563eb" strokeWidth={2} fill="url(#areaGradAtual)" dot={false} name="Atual" />
                <Area type="monotone" dataKey="projetado" stroke="#8b5cf6" strokeWidth={2} strokeDasharray="4 4" fill="url(#areaGradProj)" dot={false} name="Projetado" />
                <defs>
                  <linearGradient id="areaGradAtual" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor="#2563eb" stopOpacity={0.2} />
                    <stop offset="100%" stopColor="#2563eb" stopOpacity={0.02} />
                  </linearGradient>
                  <linearGradient id="areaGradProj" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor="#8b5cf6" stopOpacity={0.15} />
                    <stop offset="100%" stopColor="#8b5cf6" stopOpacity={0.02} />
                  </linearGradient>
                </defs>
              </AreaChart>
            </ResponsiveContainer>
          </div>
        </NeuCard>
      </div>

      {/* Detailed BI Table */}
      <NeuCard className="overflow-hidden">
        <div className="p-5 border-b border-white/5 flex items-center gap-2" style={{ background: "rgba(255,255,255,0.02)" }}>
          <BarChart3 className="w-4 h-4" style={{ color: "#2563eb" }} />
          <h3 className="text-sm font-bold text-white">Indicadores por Categoria</h3>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left" style={{ fontSize: "12px" }}>
            <thead>
              <tr style={{ borderBottom: "1px solid rgba(255,255,255,0.04)" }}>
                <th style={{ padding: "14px 24px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em", fontSize: "10px" }}>Categoria</th>
                <th style={{ padding: "14px 24px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em", fontSize: "10px", textAlign: "right" }}>Giro</th>
                <th style={{ padding: "14px 24px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em", fontSize: "10px", textAlign: "right" }}>Dias Estoque</th>
                <th style={{ padding: "14px 24px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em", fontSize: "10px", textAlign: "right" }}>Cobertura</th>
                <th style={{ padding: "14px 24px", fontWeight: 700, color: "rgba(255,255,255,0.3)", letterSpacing: "0.1em", fontSize: "10px", textAlign: "right" }}>Score</th>
              </tr>
            </thead>
            <tbody style={{ borderTop: "1px solid rgba(255,255,255,0.04)" }}>
              {giroData.map((g, gi) => {
                const score = Math.min(100, Math.round((g.giro / 10) * 50 + (1 - g.dias / 30) * 50));
                return (
                  <tr
                    key={`bi-row-${g.name}-${gi}`}
                    style={{ borderBottom: "1px solid rgba(255,255,255,0.03)", transition: "background 0.2s" }}
                    onMouseEnter={(e) => { e.currentTarget.style.background = "rgba(255,255,255,0.03)"; }}
                    onMouseLeave={(e) => { e.currentTarget.style.background = "transparent"; }}
                  >
                    <td style={{ padding: "14px 24px", fontWeight: 700, color: "white" }}>
                      <div className="flex items-center gap-2">
                        <div className="w-2 h-2 rounded-full" style={{ backgroundColor: g.fill, opacity: 0.7 }} />
                        {g.name}
                      </div>
                    </td>
                    <td style={{ padding: "14px 24px", textAlign: "right", fontWeight: 800, color: "white" }}>{g.giro}x</td>
                    <td style={{ padding: "14px 24px", textAlign: "right", fontWeight: 700, color: "white" }}>{g.dias} dias</td>
                    <td style={{ padding: "14px 24px", textAlign: "right" }}>
                      <span style={{
                        padding: "2px 10px", borderRadius: "6px", fontSize: "10px", fontWeight: 700,
                        background: g.dias <= 10 ? "rgba(16,185,129,0.15)" : g.dias <= 20 ? "rgba(37,99,235,0.15)" : "rgba(239,68,68,0.15)",
                        color: g.dias <= 10 ? "#34d399" : g.dias <= 20 ? "#60a5fa" : "#f87171",
                      }}>
                        {g.dias <= 10 ? "Ótima" : g.dias <= 20 ? "Média" : "Baixa"}
                      </span>
                    </td>
                    <td style={{ padding: "14px 24px", textAlign: "right" }}>
                      <div className="flex items-center justify-end gap-2">
                        <div style={{ width: 40, height: 4, borderRadius: "2px", background: "rgba(255,255,255,0.06)" }}>
                          <div style={{
                            width: `${score}%`, height: "100%", borderRadius: "2px",
                            background: score > 70 ? "#10b981" : score > 40 ? "#f59e0b" : "#ef4444",
                          }} />
                        </div>
                        <span style={{ fontWeight: 800, fontSize: "11px", color: "white" }}>{score}</span>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </NeuCard>
    </div>
  );
}
